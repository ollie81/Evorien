# Copy this file to ".env.local" (same folder) and fill in your own values.
# ".env.local" is listed in .gitignore and must NEVER be committed.
#
# Where to find these values: Supabase Dashboard -> your project -> Settings -> API.

# Your Supabase "Project URL". Not secret. Exposed to the browser (the
# NEXT_PUBLIC_ prefix is required for that) — this is expected and safe.
# Use the bare project URL only — no path suffix like /rest/v1/, the
# Supabase client libraries append their own paths on top of this.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "publishable" key. Safe to expose in the browser — Row Level
# Security in the database is what actually protects data, not the secrecy
# of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# NEVER add the "service_role" / "secret" key here or anywhere in this repo.
# It bypasses every Row Level Security rule. If a future feature needs it,
# it must live only in a trusted server context (e.g. a Vercel serverless
# function reading it via a non-NEXT_PUBLIC_ environment variable set in
# the Vercel dashboard, never committed to git).


# --- Site URL (recommended in production) -------------------------------
# Optional locally (falls back to the request's own origin — localhost:3000
# in dev). In Vercel's Production environment, set this explicitly to
# Ollieen's real deployed URL — https://ollieen.com once that domain is
# connected and verified in Vercel (README: "Connect ollieen.com"),
# https://your-app.vercel.app until then. Auth redirects (email
# confirmation, password reset, Google sign-in) use this as the pinned
# source of truth instead of inferring it from request headers, which
# removes any ambiguity about what origin Ollieen asks Supabase to
# redirect back to. It still has to separately match an entry in
# Supabase's Redirect URLs allow list. Deliberately NOT prefixed with
# NEXT_PUBLIC_ — this is only ever read on the server (see
# lib/site-url.ts), never in browser code, and Vercel now blocks saving a
# NEXT_PUBLIC_-prefixed variable at all unless its value is also flagged
# safe to expose, so a plain name is both more correct and required.
SITE_URL=https://ollieen.com

# --- Ollieen AI ---------------------------------------------------------
# Where to find this: platform.openai.com -> API keys (you need an OpenAI
# account with billing set up). Deliberately NOT prefixed with NEXT_PUBLIC_
# — this key must only ever be read on the server (see lib/ai/model.ts).
# Never commit a real key. Never put it in any NEXT_PUBLIC_ variable.
OPENAI_API_KEY=sk-your-openai-api-key

# Which OpenAI model Ollieen AI calls. Change this to switch models without
# touching any code. Defaults to a low-cost model in lib/ai/model.ts if unset.
AI_MODEL=gpt-5.6-luna

# Optional: max Ollieen AI messages a single member can send per day.
# Defaults to 30 in lib/ai/rate-limit.ts if unset.
AI_DAILY_MESSAGE_LIMIT=30

# --- Email notifications ------------------------------------------------
# Ollieen emails members about connection requests, accepted connections,
# new messages and verification decisions. Everything else stays in-app.
#
# How it works: the database trigger that creates a notification also POSTs
# to /api/hooks/email via pg_net, and that route forwards it to Resend. The
# database is the only party that reads a member's email address, which is
# why no service-role key is needed and why the app itself can never read
# one member's address from another member's session.
#
# Where to find this: resend.com -> API Keys. Server-only, never
# NEXT_PUBLIC_. Leave RESEND_API_KEY unset and emails are simply skipped —
# in-app notifications are unaffected.
RESEND_API_KEY=re_your-resend-api-key

# The verified sender address, e.g. "Ollieen <hello@ollieen.com>". The domain
# must be verified in Resend first, or delivery fails.
EMAIL_FROM=Ollieen <hello@ollieen.com>

# Shared secret proving a request to /api/hooks/email really came from the
# database. Generate with: openssl rand -hex 32
# The SAME value must also be stored in the database (see README) — it is
# never committed to git.
EMAIL_WEBHOOK_SECRET=generate-a-long-random-string
