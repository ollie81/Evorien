# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is listed in .gitignore and must NEVER be committed.
#
# Where to find these values: Supabase Dashboard -> your project -> Settings -> API.
#
# SUPABASE_URL is your "Project URL". It is not secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_ANON_KEY is the "anon" / "public" key. It is safe to ship inside
# the app — Row Level Security in the database is what actually protects
# data, not the secrecy of this key.
#
# NEVER put the "service_role" key here or anywhere in the Flutter app.
# The service_role key bypasses all security rules and must only ever be
# used from a trusted server (e.g. a Supabase Edge Function).
SUPABASE_ANON_KEY=your-anon-public-key
