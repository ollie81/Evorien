# Copy this file to ".env.local" (same folder) and fill in your own values.
# ".env.local" is listed in .gitignore and must NEVER be committed.
#
# Where to find these values: Supabase Dashboard -> your project -> Settings -> API.

# Your Supabase "Project URL". Not secret. Exposed to the browser (the
# NEXT_PUBLIC_ prefix is required for that) — this is expected and safe.
# Use the bare project URL only — no path suffix like /rest/v1/, the
# Supabase client libraries append their own paths on top of this.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "publishable" key. Safe to expose in the browser — Row Level
# Security in the database is what actually protects data, not the secrecy
# of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key


# NEVER add the "service_role" / "secret" key here or anywhere in this repo.
# It bypasses every Row Level Security rule. If a future feature needs it,
# it must live only in a trusted server context (e.g. a Vercel serverless
# function reading it via a non-NEXT_PUBLIC_ environment variable set in
# the Vercel dashboard, never committed to git).


# --- Evorien AI ---------------------------------------------------------
# Where to find this: platform.openai.com -> API keys (you need an OpenAI
# account with billing set up). Deliberately NOT prefixed with NEXT_PUBLIC_
# — this key must only ever be read on the server (see lib/ai/model.ts).
# Never commit a real key. Never put it in any NEXT_PUBLIC_ variable.
OPENAI_API_KEY=sk-your-openai-api-key

# Which OpenAI model Evorien AI calls. Change this to switch models without
# touching any code. Defaults to a low-cost model in lib/ai/model.ts if unset.
AI_MODEL=gpt-5.6-luna

# Optional: max Evorien AI messages a single member can send per day.
# Defaults to 30 in lib/ai/rate-limit.ts if unset.
AI_DAILY_MESSAGE_LIMIT=30
